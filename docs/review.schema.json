{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CopperReview feedback v1",
  "type": "object",
  "required": ["schema", "tool", "exported_at", "board", "summary", "geometry_counts", "inspection_limits", "annotations"],
  "properties": {
    "schema": {"const": "copper-review/v1"},
    "tool": {"type": "object", "required": ["name", "version"], "properties": {"name": {"const": "CopperReview"}, "version": {"type": "string"}}},
    "exported_at": {"type": "string", "format": "date-time"},
    "board": {"$ref": "#/$defs/board"},
    "summary": {"type": "string"},
    "geometry_counts": {
      "type": "object", "required": ["components", "nets", "track_segments", "vias", "zone_polygons"],
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "inspection_limits": {"type": "array", "items": {"type": "string"}},
    "annotations": {"type": "array", "items": {"$ref": "#/$defs/annotation"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "point": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "bounds": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
    "strings": {"type": "array", "items": {"type": "string"}},
    "geometryObjects": {"type": "array", "items": {"type": "object"}},
    "board": {
      "type": "object", "required": ["name", "filename", "sha256", "stage", "stage_evidence", "source", "bounds_mm", "coordinates", "layers"],
      "properties": {
        "name": {"type": "string"}, "filename": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"},
        "stage": {"enum": ["unknown", "placed", "partially_routed", "fully_routed"]},
        "stage_evidence": {"type": "string"},
        "source": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["filename", "sha256"], "properties": {"filename": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}}]},
        "bounds_mm": {"$ref": "#/$defs/bounds"},
        "layers": {"$ref": "#/$defs/strings"},
        "coordinates": {
          "type": "object", "required": ["units", "origin", "x_axis", "y_axis", "view", "positive_rotation"],
          "properties": {"units": {"const": "mm"}, "origin": {"type": "string"}, "x_axis": {"const": "right"}, "y_axis": {"const": "down"}, "view": {"type": "string"}, "positive_rotation": {"const": "counterclockwise"}}
        }
      }
    },
    "selection": {
      "type": "object", "required": ["components", "nets", "region"],
      "properties": {"components": {"$ref": "#/$defs/strings"}, "nets": {"$ref": "#/$defs/strings"}, "region": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/bounds"}]}}
    },
    "context": {
      "type": "object", "required": ["components", "nets", "region"],
      "properties": {
        "components": {"$ref": "#/$defs/geometryObjects"},
        "nets": {"type": "array", "items": {"type": "object", "required": ["name", "pads", "tracks", "vias", "zones"], "properties": {"name": {"type": "string"}, "pads": {"$ref": "#/$defs/geometryObjects"}, "tracks": {"$ref": "#/$defs/geometryObjects"}, "vias": {"$ref": "#/$defs/geometryObjects"}, "zones": {"$ref": "#/$defs/geometryObjects"}}}},
        "region": {
          "oneOf": [{"type": "null"}, {
            "type": "object", "required": ["bounds_mm", "query_layers", "query_precision", "context"],
            "properties": {"bounds_mm": {"$ref": "#/$defs/bounds"}, "query_layers": {"$ref": "#/$defs/strings"}, "query_precision": {"type": "string"},
              "context": {"type": "object", "required": ["components", "nets", "pads", "tracks", "vias", "zones", "drawings"], "properties": {"components": {"$ref": "#/$defs/geometryObjects"}, "nets": {"$ref": "#/$defs/strings"}, "pads": {"$ref": "#/$defs/geometryObjects"}, "tracks": {"$ref": "#/$defs/geometryObjects"}, "vias": {"$ref": "#/$defs/geometryObjects"}, "zones": {"$ref": "#/$defs/geometryObjects"}, "drawings": {"$ref": "#/$defs/geometryObjects"}}}}
          }]
        }
      }
    },
    "annotation": {
      "type": "object", "required": ["id", "created_at", "category", "priority", "status", "observation", "desired_behavior", "board_wide", "selection", "visible_layers", "context"],
      "properties": {
        "id": {"type": "string", "format": "uuid"}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"},
        "category": {"enum": ["placement", "routing", "package_escape", "return_path", "mechanical", "algorithm", "other"]},
        "priority": {"enum": ["low", "medium", "high"]}, "status": {"enum": ["open", "resolved"]},
        "observation": {"type": "string", "minLength": 1}, "desired_behavior": {"type": "string"}, "board_wide": {"type": "boolean"},
        "selection": {"$ref": "#/$defs/selection"}, "visible_layers": {"$ref": "#/$defs/strings"}, "context": {"$ref": "#/$defs/context"}
      }
    }
  }
}
